{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/user",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 8001
        },
        {
          "Host": "localhost",
          "Port": 8004
        },
        {
          "Host": "localhost",
          "Port": 8005
        }
      ],
      "UpstreamPathTemplate": "/api/user",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "RateLimitOptions": {
        "ClientIdHeader": "ClientId",
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "60s",
        "PeriodTimespan": 6,
        "Limit": 2
      },
      "Key": "UserService",
      "LoadBalancerOptions": {
        "Type": "LeastConnection"
      }
      
    },
    {
      "DownstreamPathTemplate": "/api/product",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 8002
        }
      ],
      "UpstreamPathTemplate": "/api/product",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "Key": "ProductService"
    },

    {
      "DownstreamPathTemplate": "/api/account/login/{email}/{password}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 8003
        }
      ],
      "UpstreamPathTemplate": "/api/account/login/{email}/{password}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "60s",
        "PeriodTimespan": 6,
        "Limit": 2
      }
      
    },

    {
      "DownstreamPathTemplate": "/api/account/register/{email}/{password}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 8003
        }
      ],
      "UpstreamPathTemplate": "/api/account/register/{email}/{password}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    }
  ],

  "Aggregates": [
    {
      "RouteKeys": [
        "UserService",
        "ProductService"
      ],
      "UpstreamPathTemplate": "/api/aggregate/user_prod",
      "UpstreamHttpMethod": [ "GET" ],
      "ReRouteKeysConfig": [
        {
          "RouteKey": "UserService",
          "JsonPath": "$"
        },
        {
          "RouteKey": "ProductService",
          "JsonPath": "$"
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https ://localhost:8000",
    "CacheOptions": {
      "TtlSeconds": 30,
      "Region": "default",
      "Header": "OC-Caching-Control",
      "EnableContentHashing": false
    }
  }
}
